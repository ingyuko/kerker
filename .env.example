# IBKR Gateway connection (paper trading defaults)
# Gateway paper: 4002, Gateway live: 4001
# TWS paper:     7497, TWS live:     7496
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=

# Strategy parameters (override config defaults)
BPS_SYMBOL=SPY
BPS_DTE_MIN=30
BPS_DTE_MAX=45
BPS_SHORT_DELTA=0.20
BPS_SPREAD_WIDTH=5
BPS_MIN_CREDIT_RATIO=0.25
BPS_QUANTITY=1
BPS_VIX_MIN=12
BPS_VIX_MAX=28

# Scheduler
BPS_MINUTES_AFTER_OPEN=30
BPS_MARKET_TZ=America/New_York

# Set to 1 to actually transmit orders, 0 to only stage (whatIf)
BPS_TRANSMIT=0
