# IBKR Gateway connection (paper trading defaults)
# Gateway paper: 4002, Gateway live: 4001
# TWS paper:     7497, TWS live:     7496
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=

# Strategy parameters (override config defaults)
BPS_SYMBOL=SPY
BPS_DTE_MIN=30
BPS_DTE_MAX=45
BPS_SHORT_DELTA=0.20
BPS_SPREAD_WIDTH=5
BPS_MIN_CREDIT_RATIO=0.25
BPS_QUANTITY=1
BPS_VIX_MIN=12
BPS_VIX_MAX=28

# Scheduler
BPS_MINUTES_AFTER_OPEN=30
BPS_MARKET_TZ=America/New_York

# Set to 1 to actually transmit orders, 0 to only stage (whatIf)
BPS_TRANSMIT=0

# --- 選擇權每日損益追蹤器 (/options) ---
# Postgres connection string (Neon, Supabase, Vercel Postgres…). Required in
# production; without it the app falls back to a local .data/options.json file.
DATABASE_URL=

# Passcode for the tracker. Required in production — the record sits behind a
# public URL, and without this the app refuses to serve.
APP_PASSCODE=
# Optional: keeps sessions valid across a passcode change.
APP_SESSION_SECRET=

# Needed for reading thinkorswim screenshots. Manual entry works without it.
ANTHROPIC_API_KEY=
