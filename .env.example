# IBKR Gateway connection (paper trading defaults)
# Gateway paper: 4002, Gateway live: 4001
# TWS paper:     7497, TWS live:     7496
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=

# Strategy parameters (override config defaults)
BPS_SYMBOL=SPY
BPS_DTE_MIN=30
BPS_DTE_MAX=45
BPS_SHORT_DELTA=0.20
BPS_SPREAD_WIDTH=5
BPS_MIN_CREDIT_RATIO=0.25
BPS_QUANTITY=1
BPS_VIX_MIN=12
BPS_VIX_MAX=28

# Scheduler
BPS_MINUTES_AFTER_OPEN=30
BPS_MARKET_TZ=America/New_York

# Set to 1 to actually transmit orders, 0 to only stage (whatIf)
BPS_TRANSMIT=0

# ---------------------------------------------------------------------------
# Intraday TTM Squeeze + MACD + RSI futures bot (python -m kerker intraday)
# ---------------------------------------------------------------------------
# Instrument: MES = Micro E-mini S&P 500 (safe default). For /ES set
# INTRADAY_SYMBOL=ES and INTRADAY_POINT_VALUE=50.
INTRADAY_SYMBOL=MES
INTRADAY_EXCHANGE=CME
INTRADAY_POINT_VALUE=5
INTRADAY_TICK_SIZE=0.25
INTRADAY_QUANTITY=1

# Bars
INTRADAY_BAR_SIZE=5 mins
INTRADAY_HISTORY_DURATION=3 D
INTRADAY_USE_RTH=1

# TTM Squeeze (Bollinger 20/2 inside Keltner 20/1.5, momentum 20)
INTRADAY_BB_LENGTH=20
INTRADAY_BB_MULT=2.0
INTRADAY_KC_LENGTH=20
INTRADAY_KC_MULT=1.5
INTRADAY_MOMENTUM_LENGTH=20
INTRADAY_MIN_SQUEEZE_BARS=4
INTRADAY_FIRE_LOOKBACK=3

# MACD 12/26/9
INTRADAY_MACD_FAST=12
INTRADAY_MACD_SLOW=26
INTRADAY_MACD_SIGNAL=9

# RSI filter windows
INTRADAY_RSI_LENGTH=14
INTRADAY_RSI_LONG_MIN=50
INTRADAY_RSI_LONG_MAX=75
INTRADAY_RSI_SHORT_MIN=25
INTRADAY_RSI_SHORT_MAX=50

# VWAP trend filter (1=on)
INTRADAY_USE_VWAP_FILTER=1

# Risk: ATR stop/target, daily circuit breakers
INTRADAY_ATR_LENGTH=14
INTRADAY_STOP_ATR_MULT=1.5
INTRADAY_TARGET_ATR_MULT=2.5
INTRADAY_MAX_TRADES_PER_DAY=6
INTRADAY_MAX_DAILY_LOSS=500

# Session windows (market tz, bar-start times)
INTRADAY_MARKET_TZ=America/New_York
INTRADAY_SESSION_START=09:30
INTRADAY_SESSION_END=16:00
INTRADAY_WARMUP_MINUTES=15
INTRADAY_NO_ENTRY_MINUTES=30
INTRADAY_FLATTEN_MINUTES=10

# SAFETY: 1 = log signals only (no orders). Set 0 to send real orders
# to whatever gateway IBKR_PORT points at (4002 = paper).
INTRADAY_DRY_RUN=1
